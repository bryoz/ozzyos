{
  "color": {
    "$type": "color",
    "bg": {
      "default": { "$value": "{color.white}" }, "subtle": { "$value": "{color.neutral.50}" },
      "muted": { "$value": "{color.neutral.100}" }, "inverse": { "$value": "{color.neutral.900}" },
      "accent": { "$value": "{brand.primary.subtle}" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" }, "muted": { "$value": "{color.neutral.600}" },
      "inverse": { "$value": "{color.white}" }, "link": { "$value": "{brand.primary.base}" },
      "link-hover": { "$value": "{brand.primary.strong}" }
    },
    "border": { "default": { "$value": "{color.neutral.200}" }, "strong": { "$value": "{color.neutral.500}" } },
    "action": {
      "primary": { "$value": "{brand.primary.base}" }, "primary-hover": { "$value": "{brand.primary.strong}" },
      "on-primary": { "$value": "{color.white}" }
    },
    "focus": { "ring": { "$value": "{brand.primary.base}" } },
    "status": {
      "danger": { "$value": "{color.red.700}" }, "success": { "$value": "{color.green.700}" }, "warning": { "$value": "{color.amber.700}" }
    }
  }
}
