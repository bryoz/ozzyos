{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "serif": { "$value": ["Georgia", "Cambria", "Times New Roman", "serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" }, "sm": { "$value": "0.875rem" }, "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" }, "xl": { "$value": "1.25rem" }, "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" }, "4xl": { "$value": "2.25rem" }, "5xl": { "$value": "3rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 }, "snug": { "$value": 1.35 }, "normal": { "$value": 1.6 }
    }
  },
  "motion": {
    "duration": { "$type": "duration", "fast": { "$value": "120ms" }, "normal": { "$value": "200ms" } },
    "easing": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] } }
  }
}
