{
  "space": {
    "$type": "dimension",
    "0": { "$value": "0rem" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" }, "4": { "$value": "1rem" }, "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" }, "7": { "$value": "3rem" }, "8": { "$value": "4rem" }, "9": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0rem" }, "sm": { "$value": "0.25rem" }, "md": { "$value": "0.5rem" },
    "lg": { "$value": "1rem" }, "full": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "container": { "sm": { "$value": "40rem" }, "md": { "$value": "48rem" }, "lg": { "$value": "64rem" }, "xl": { "$value": "80rem" } },
    "measure": { "$value": "68ch", "$description": "Max line length for prose" }
  }
}
