{
  "name": "@ozzyos/react",
  "version": "0.0.0",
  "description": "OzzyOS React components, built on React Aria Components and styled by @ozzyos/css",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryoz/ozzyos.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/bryoz/ozzyos#readme",
  "bugs": "https://github.com/bryoz/ozzyos/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ozzyos/css": "workspace:^",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-aria-components": "^1.22.1"
  },
  "devDependencies": {
    "@ozzyos/css": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.10.0",
    "jsdom": "^26.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  }
}
