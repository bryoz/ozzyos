{
  "name": "@ozzyos/tokens",
  "version": "0.1.0",
  "description": "OzzyOS design tokens: CSS variables, JS and JSON, built from DTCG sources",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryoz/ozzyos.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/bryoz/ozzyos#readme",
  "bugs": "https://github.com/bryoz/ozzyos/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./css": "./dist/css/tokens.css",
    "./css/*": "./dist/css/*",
    "./js/*": "./dist/js/*",
    "./json/*": "./dist/json/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node src/build.js && node src/contrast.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "style-dictionary": "^5.0.0"
  }
}
