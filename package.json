{
  "name": "ozzyos",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "storybook": "pnpm --filter @ozzyos/storybook dev",
    "build-storybook": "turbo run build --filter=@ozzyos/storybook",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
